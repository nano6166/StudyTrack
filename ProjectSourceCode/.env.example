# Copy this file to .env (same folder, ProjectSourceCode/) before running docker compose up.
# .env is in .gitignore and must never be committed. Pick your own passwords and secret.

# Read by the Postgres container. src/server.js always connects as user "postgres"
# to database "studytrack", so keep these two values as they are.
POSTGRES_USER=postgres
POSTGRES_DB=studytrack
POSTGRES_PASSWORD=change-me

# Read by src/server.js. "password" must match POSTGRES_PASSWORD above.
password=change-me
SESSION_SECRET=change-me-to-a-long-random-string
