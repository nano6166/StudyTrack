# Copy this file to .env.test (same folder, ProjectSourceCode/) before running the tests.
# .env.test is in .gitignore. These values are only for the throwaway test database in
# docker-compose.test.yaml; never put the development or a real password here.
NODE_ENV=test

# Read by the Postgres test container (creates the "studytrack" database for user "postgres")
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studytrack

# Read by src/server.js and test/helpers/db.js. "password" must match POSTGRES_PASSWORD.
DB_HOST=db-test
password=change-me

SESSION_SECRET=change-me-too
